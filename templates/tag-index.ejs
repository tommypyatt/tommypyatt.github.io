<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <header class="mb-10">
    <nav class="text-sm mb-4" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-foreground-subtle">
        <li><a href="<%= resolveUrl('/blog/') %>" class="hover:text-primary-400 transition-colors">Blog</a></li>
        <li><span class="text-foreground-disabled">/</span></li>
        <li class="text-foreground" aria-current="page">Tags</li>
      </ol>
    </nav>
    <h1 class="text-3xl md:text-4xl font-bold text-foreground-heading mb-4">Browse by Tag</h1>
    <p class="text-foreground-muted">Explore posts organized by topic</p>
  </header>

  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% if (tags && tags.length > 0) { %>
      <% tags.forEach(({ tag, slug, count }) => { %>
      <li class="border border-border rounded-lg p-4 hover:border-primary-400 hover:bg-background-elevated transition-all">
        <a href="<%= resolveUrl(`/blog/tags/${slug}/`) %>" class="flex items-center justify-between group">
          <span class="text-lg font-medium text-foreground-heading group-hover:text-primary-400 transition-colors">
            <%= tag %>
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-background-elevated text-foreground-subtle border border-border">
            <%= count %> <%= count === 1 ? 'post' : 'posts' %>
          </span>
        </a>
      </li>
      <% }); %>
    <% } else { %>
      <li class="text-foreground-subtle">No tags found.</li>
    <% } %>
  </ul>
</div>
