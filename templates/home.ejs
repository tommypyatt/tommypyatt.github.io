<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

  <!-- Hero -->
  <section class="py-16 md:py-24">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary-500/10 border border-primary-500/30 text-primary-400 text-sm font-medium rounded-full mb-8">
      <span class="w-2 h-2 bg-primary-400 rounded-full"></span>
      Available for contract
    </div>
    <h1 class="text-4xl md:text-5xl font-bold font-serif text-foreground-heading mb-6">
      Tommy Pyatt
    </h1>
    <p class="text-lg md:text-xl text-foreground-muted mb-10 max-w-2xl leading-relaxed">
      Adobe Commerce Frontend Expert with 13+ years building high-performance storefronts. Specialising in Hyvä themes, Tailwind CSS, and Alpine.js. Based in Manchester, working remotely.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="<%= resolveUrl('/cv/') %>" class="inline-flex items-center px-5 py-2.5 bg-primary-500 hover:bg-primary-600 text-white hover:text-white font-medium rounded-lg transition-colors">
        View CV
      </a>
      <a href="mailto:tommy@pyatt.me" class="inline-flex items-center px-5 py-2.5 border border-border hover:border-primary-400 text-foreground hover:text-primary-400 font-medium rounded-lg transition-colors">
        Get in touch
      </a>
    </div>
  </section>

  <!-- Specialisms -->
  <section class="py-10 border-t border-border-subtle">
    <p class="text-xs font-semibold text-foreground-subtle uppercase tracking-widest mb-5">Specialisms</p>
    <div class="flex flex-wrap gap-2">
      <% ['Hyvä Themes', 'Alpine.js', 'Tailwind CSS', 'Adobe Commerce', 'Magento 2', 'Performance optimisation', 'Accessibility (WCAG)', 'JavaScript (ES6+)', 'GraphQL', 'Adobe Commerce Cloud'].forEach(function(skill) { %>
      <span class="px-3 py-1.5 bg-background-surface border border-border-subtle rounded-full text-sm text-foreground-heading">
        <%= skill %>
      </span>
      <% }); %>
    </div>
  </section>

  <!-- Notable work -->
  <section class="py-10 border-t border-border-subtle">
    <p class="text-xs font-semibold text-foreground-subtle uppercase tracking-widest mb-5">Notable work</p>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="p-5 bg-background-surface rounded-lg border border-border-subtle">
        <p class="text-foreground-heading font-semibold mb-2">Cox &amp; Cox</p>
        <p class="text-foreground-muted text-sm leading-relaxed">Led the full Hyvä frontend rebuild. Won Best Upgrade at Magento Imagine 2018.</p>
      </div>
      <div class="p-5 bg-background-surface rounded-lg border border-border-subtle">
        <p class="text-foreground-heading font-semibold mb-2">Poundland</p>
        <p class="text-foreground-muted text-sm leading-relaxed">Led the frontend implementation. Ranked in the top 10 major UK retailers by Sitemorse in 2014.</p>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="py-10 border-t border-border-subtle">
    <p class="text-foreground-muted">
      I also write occasionally about frontend development and tooling.
      <a href="<%= resolveUrl('/blog/') %>">Read my writing.</a>
    </p>
  </section>

</div>
